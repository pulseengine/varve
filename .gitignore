/target
**/*.rs.bk
# Cargo.lock tracked (26262-8 config-management: releases must rebuild from VCS)
.DS_Store
/dist
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
fuzz/Cargo.lock

# Python bytecode from tools/
__pycache__/
*.pyc
mutants.out/
mutants.out.old/

# Agent worktrees — never commit these (they are live git repos)
.claude/worktrees/

# `cargo cyclonedx` writes crates/<name>/<name>.cdx.json into the tree;
# release.yml generates them for each release, so a local copy is never committed.
crates/*/*.cdx.json
